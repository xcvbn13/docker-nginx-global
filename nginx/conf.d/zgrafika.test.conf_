server {
  listen 80;
  server_name grafika.test;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name grafika.test;

  ssl_certificate /etc/nginx/certs/grafika.test.pem;
  ssl_certificate_key /etc/nginx/certs/grafika.test-key.pem;

  client_max_body_size 50M;

  # Forward all requests as HTTP to service/container grafika_nginx:80
  location / {
    proxy_pass http://grafika_nginx:80;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_request_buffering off;
    proxy_buffering off;
  }
}
